{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles for students and lecturers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "lecturer", "admin"] },
        "faculty": { "type": "string" },
        "department": { "type": "string" },
        "department_id": { "type": "string" },
        "level": { "type": "string" },
        "office_location": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "email", "first_name", "last_name", "role"]
    },
    "slots": {
      "title": "Consultation Slots",
      "description": "Available time slots created by lecturers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lecturer_id": { "type": "string" },
        "date": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "is_booked": { "type": "boolean" }
      },
      "required": ["id", "lecturer_id", "date", "start_time", "end_time", "is_booked"]
    },
    "appointments": {
      "title": "Appointments",
      "description": "Bookings between students and lecturers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "student_id": { "type": "string" },
        "lecturer_id": { "type": "string" },
        "slot_id": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "completed"] },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "student_id", "lecturer_id", "slot_id", "status"]
    }
  }
}
